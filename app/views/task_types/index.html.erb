<style>
  .types-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 20px;
    font-family: 'Georgia', serif;
  }

  .types-header {
    text-align: center;
    margin-bottom: 50px;
  }

  .types-title {
    font-size: 2.2rem;
    color: #2d3748;
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
  }

  .level-info {
    color: #718096;
    font-size: 1.1rem;
    font-family: 'Courier New', monospace;
  }

  .types-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 30px;
    margin-bottom: 40px;
  }

  .type-card {
    background: white;
    border-radius: 16px;
    padding: 40px 35px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
    transition: all 0.3s;
    text-align: center;
    border: 2px solid #e2e8f0;
  }

  .type-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 30px rgba(102, 126, 234, 0.2);
    border-color: #667eea;
  }

  .type-icon {
    font-size: 3.5rem;
    margin-bottom: 20px;
  }

  .type-card h3 {
    font-size: 1.7rem;
    color: #2d3748;
    margin-bottom: 15px;
    font-family: 'Georgia', serif;
  }

  .type-card p {
    color: #718096;
    margin-bottom: 25px;
    line-height: 1.6;
    font-size: 1rem;
  }

  .btn-type {
    display: inline-block;
    padding: 14px 40px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    text-decoration: none;
    border-radius: 12px;
    font-weight: 600;
    font-size: 1.1rem;
    transition: all 0.3s;
    box-shadow: 0 4px 10px rgba(102, 126, 234, 0.3);
  }

  .btn-type:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(102, 126, 234, 0.4);
  }

  .btn-back {
    display: inline-block;
    padding: 12px 30px;
    background: #718096;
    color: white;
    text-decoration: none;
    border-radius: 10px;
    font-weight: 600;
    transition: all 0.3s;
  }

  .btn-back:hover {
    background: #4a5568;
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .types-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="types-container">
  <div class="types-header">
    <h1 class="types-title">📚 <%= @level.name %></h1>
    <p class="level-info">Выберите тип задач</p>
  </div>

  <div class="types-grid">
    <% @task_types.each do |type| %>
      <div class="type-card">
        <div class="type-icon">
          <%= type.name == "Жизнь и смерть" ? "⚔️" : "✨" %>
        </div>
        <h3><%= type.name %></h3>
        <p><%= type.instructions %></p>
        <%= link_to "Открыть задачи", 
            task_level_task_type_tasks_path(@level, type, horror: params[:horror]), 
            class: "btn-type" %>
      </div>
    <% end %>
  </div>

  <div style="text-align: center;">
    <%= link_to "← Назад к уровням", tasks_menu_path(horror: params[:horror]), class: "btn-back" %>
  </div>
</div>