<div class="auth-container">
  <h2>Вход в Weiqi Core</h2>
  
  <%= form_with url: login_path, method: :post, local: true do |form| %>
    <div class="form-group">
      <%= form.label :email, "Email" %>
      <%= form.email_field :email, required: true, class: "form-control" %>
    </div>
    
    <div class="form-group">
      <%= form.label :password, "Пароль" %>
      <%= form.password_field :password, required: true, class: "form-control" %>
    </div>
    
    <div class="form-actions">
      <%= form.submit "Войти", class: "btn btn-primary" %>
      <%= link_to "Зарегистрироваться", signup_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>