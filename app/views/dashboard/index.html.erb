<div class="dashboard-page">
  <div class="dashboard-container">
    <div class="dashboard-header">
      <h1>Weiqi Core</h1>
      <p class="welcome-text">Добро пожаловать, <%= current_user.name %>!</p>
    </div>
    
    <div class="menu-grid">
      <!-- Кнопка 1: Задачник -->
      <div class="menu-card">
        <div class="card-icon">🧩</div>
        <h3>Задачник</h3>
        <p>Решайте задачи по вейци в обычном или хоррор-режиме</p>
        <%= link_to "Открыть", tasks_menu_path, class: "btn btn-card" %>
      </div>
      
      <!-- Кнопка 2: Игра на двоих -->
      <div class="menu-card">
        <div class="card-icon">👥</div>
        <h3>Игра на двоих</h3>
        <p>Сразитесь с другом в вейци в обычном или хоррор-режиме</p>
        <%= link_to "Открыть", game_menu_path, class: "btn btn-card" %>
      </div>
      
      <!-- Кнопка 3: Мини-игры -->
      <div class="menu-card">
        <div class="card-icon">🎮</div>
        <h3>Мини-игры</h3>
        <p>Расслабтесь в виселице, судоку или крестиках-ноликах</p>
        <%= link_to "Открыть", minigames_menu_path, class: "btn btn-card" %>
      </div>
    </div>
    
    <div class="dashboard-footer">
      <%= button_to "Выйти", logout_path, method: :delete, class: "btn btn-logout" %>
    </div>
  </div>
</div>

<style>
  /* Стили для Dashboard */
  .dashboard-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    padding: 20px;
  }
  
  .dashboard-container {
    background: white;
    padding: 50px 40px;
    border-radius: 16px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    max-width: 900px;
    width: 100%;
    text-align: center;
  }
  
  .dashboard-header {
    margin-bottom: 40px;
  }
  
  .dashboard-header h1 {
    margin: 0 0 15px 0;
    color: #333;
    font-size: 2.5rem;
  }
  
  .welcome-text {
    color: #666;
    font-size: 1.2rem;
    margin: 0;
  }
  
  .menu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 30px;
    margin-bottom: 40px;
  }
  
  .menu-card {
    background: #f8f9fa;
    padding: 30px;
    border-radius: 12px;
    border: 2px solid #e9ecef;
    transition: transform 0.3s, box-shadow 0.3s, border-color 0.3s;
    cursor: pointer;
  }
  
  .menu-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    border-color: #667eea;
  }
  
  .card-icon {
    font-size: 3rem;
    margin-bottom: 15px;
  }
  
  .menu-card h3 {
    margin: 0 0 10px 0;
    color: #333;
    font-size: 1.3rem;
  }
  
  .menu-card p {
    color: #666;
    margin: 0 0 20px 0;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  
  .btn-card {
    display: inline-block;
    padding: 10px 30px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  
  .btn-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 20px rgba(102, 126, 234, 0.4);
  }
  
  .dashboard-footer {
    padding-top: 30px;
    border-top: 2px solid #e9ecef;
  }
  
  .btn-logout {
    background: #6c757d;
    color: white;
    border: none;
    padding: 12px 30px;
    border-radius: 8px;
    font-size: 1rem;
    cursor: pointer;
    transition: background 0.3s, transform 0.2s;
  }
  
  .btn-logout:hover {
    background: #5a6268;
    transform: translateY(-2px);
  }
</style>