<h1 style="text-align: center; margin-bottom: 20px;">Крестики-нолики</h1>

<% if @game_over %>
  <p style="font-size: 1.3rem; margin: 20px 0; text-align: center; font-weight: bold; color: #2c3e50;">
    <% if @winner %>
      Победил <%= @winner == 'X' ? 'X' : 'O' %>!
    <% else %>
      Ничья!
    <% end %>
  </p>
<% else %>
  <p style="font-size: 1.1rem; margin: 20px 0; text-align: center;">
    Ход игрока: <strong style="color: #3498db; font-size: 1.3rem;"><%= @player %></strong>
  </p>
<% end %>

<div style="display: flex; justify-content: center; margin: 30px 0;">
  <%= form_with url: minigames_tictactoe_path, method: :post, local: true do %>
    <div style="display: grid; grid-template-columns: repeat(3, 100px); gap: 5px; background: #34495e; padding: 5px; border-radius: 8px;">
      <% @board.each_with_index do |cell, index| %>
        <button type="submit" 
                name="position" 
                value="<%= index %>"
                <%= 'disabled' if cell || @game_over %>
                style="
                  width: 100px; 
                  height: 100px; 
                  font-size: 2.5rem; 
                  font-weight: bold;
                  background: <%= cell ? '#ecf0f1' : '#ffffff' %>;
                  border: none;
                  border-radius: 4px;
                  cursor: <%= cell || @game_over ? 'not-allowed' : 'pointer' %>;
                  color: <%= cell == 'X' ? '#3498db' : '#e74c3c' %>;
                  transition: all 0.2s;
                "
                onmouseover="<%= cell || @game_over ? '' : 'this.style.background=\"#d5dbdb\"' %>"
                onmouseout="<%= cell || @game_over ? '' : 'this.style.background=\"' + (cell ? '#ecf0f1' : '#ffffff') + '\"' %>">
          <%= cell || '' %>
        </button>
      <% end %>
    </div>
  <% end %>
</div>

<div style="margin-top: 30px; text-align: center;">
  <%= button_to 'Новая игра', minigames_tictactoe_path, method: :delete,
      style: "padding: 12px 30px; background: #e74c3c; color: white; border: none; border-radius: 8px; cursor: pointer; font-size: 1rem; margin: 0 10px 15px 0; display: inline-block; box-shadow: 0 4px 6px rgba(0,0,0,0.1);" %>

  <%= link_to 'В меню', minigames_menu_path,
      style: "display: inline-block; padding: 12px 30px; background: #3498db; color: white; text-decoration: none; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); vertical-align: middle;" %>
</div>

<p style="font-size: 0.9rem; color: #7f8c8d; margin-top: 30px; max-width: 400px; margin-left: auto; margin-right: auto; text-align: center; line-height: 1.5;">
  Нажимай на клетки, чтобы сделать ход. Первый собравший три в ряд побеждает
</p>