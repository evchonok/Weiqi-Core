<h1>🔤 Виселица</h1>

<% if @status == "won" %>
  <p style="color: #27ae60; font-weight: bold; font-size: 1.3rem;">🎉 Поздравляю! Ты угадал слово!</p>
<% elsif @status == "lost" %>
  <p style="color: #c0392b; font-weight: bold; font-size: 1.3rem;">💀 Ты проиграл! Слово: <u><%= @word %></u></p>
<% else %>
  <p style="font-size: 1.1rem;">Ошибок: <strong><%= @mistakes %></strong> из <%= @max_mistakes %></p>
<% end %>

<!-- Рисунок виселицы -->
<pre style="font-family: monospace; font-size: 1.4rem; line-height: 1.2; margin: 25px 0; background: #f8f9fa; padding: 15px; border-radius: 8px; display: inline-block;">
  _______
  |     |
  |     <%= @mistakes >= 1 ? "O" : " " %>
  |    <%= @mistakes >= 3 ? "/" : " " %><%= @mistakes >= 2 ? "|" : " " %><%= @mistakes >= 4 ? "\\" : " " %>
  |    <%= @mistakes >= 6 ? "/" : " " %> <%= @mistakes >= 5 ? "\\" : " " %>
  |
 _|_
</pre>

<!-- Слово с подчёркиваниями -->
<div style="font-size: 2.2rem; letter-spacing: 8px; margin: 25px 0; font-family: monospace; font-weight: bold;">
  <% @word.each_char do |char| %>
    <% if @status == "lost" || @guessed.include?(char) %>
      <span style="color: #2c3e50;"><%= char %></span>
    <% else %>
      <span style="color: #95a5a6;">_</span>
    <% end %>
  <% end %>
</div>

<!-- Угаданные буквы -->
<% if @guessed.any? %>
  <p style="color: #7f8c8d; font-size: 0.95rem; margin-bottom: 20px;">
    Буквы: <%= @guessed.join(', ') %>
  </p>
<% end %>

<!-- Форма ввода (только если игра идёт) -->
<% if @status == "playing" %>
  <%= form_with url: hangman_guess_path, method: :post, local: true do %>
    <div style="margin: 25px 0;">
      <input type="text" name="letter" maxlength="1" required 
             style="width: 60px; height: 60px; font-size: 1.8rem; text-align: center; text-transform: uppercase; border: 2px solid #3498db; border-radius: 8px;"
             placeholder="А" autofocus>
      <button type="submit" style="height: 60px; padding: 0 25px; font-size: 1.1rem; margin-left: 10px; background: #3498db; color: white; border: none; border-radius: 8px; cursor: pointer;">
        Проверить
      </button>
    </div>
  <% end %>
<% end %>

<!-- Кнопки -->
<div style="margin-top: 30px;">
  <%= button_to '🔄 Новая игра', hangman_path, method: :delete,
      style: "padding: 12px 25px; background: #e74c3c; color: white; border: none; border-radius: 6px; cursor: pointer; font-size: 1rem;" %>
  
  <%= link_to '🏠 В меню', minigames_menu_path,
      style: "margin-left: 12px; padding: 12px 25px; background: #3498db; color: white; text-decoration: none; border-radius: 6px; display: inline-block; font-size: 1rem;" %>
</div>