<h1> Судоку</h1>

<% if @status == "won" %>
  <p style="color: #27ae60; font-weight: bold; font-size: 1.5rem; margin: 20px 0;">🎉 Поздравляю! Судоку решено верно!</p>
<% else %>
  <p style="font-size: 1.1rem; margin: 20px 0;">Ошибок: <strong style="color: #e74c3c;"><%= @errors || 0 %></strong></p>
<% end %>

<%= form_with url: sudoku_guess_path, method: :post, local: true do %>
  <!-- Сетка 9x9 -->
  <div style="display: inline-grid; grid-template-columns: repeat(9, 40px); gap: 1px; background: #333; padding: 2px; border-radius: 4px;">
    <% 0.upto(8) do |row| %>
      <% 0.upto(8) do |col| %>
        <%
          original = @board[row][col]
          # Толстые границы для блоков 3x3
          border_right = (col == 2 || col == 5) ? "border-right: 3px solid #000;" : ""
          border_bottom = (row == 2 || row == 5) ? "border-bottom: 3px solid #000;" : ""
          # Значение, введённое пользователем (или пустая строка)
          user_val = @user_input["#{row}_#{col}"] || ""
        %>
        <div style="
          width: 40px; height: 40px; 
          background: <%= original != 0 ? '#e0e0e0' : '#fff' %>;
          display: flex; align-items: center; justify-content: center;
          font-weight: bold;
          <%= border_right %><%= border_bottom %>
        ">
          <% if original != 0 %>
            <!-- Исходная цифра (нельзя менять) -->
            <span style="color: #555;"><%= original %></span>
          <% else %>
            <!-- Поле для ввода -->
            <input type="number" 
                   name="sudoku[<%= row %>][<%= col %>]" 
                   value="<%= user_val %>" 
                   min="1" max="9" 
                   style="width: 100%; height: 100%; text-align: center; border: none; font-size: 1.2rem; background: transparent; outline: none;"
                   <%= 'disabled' if @status == 'won' %>>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>

  <div style="margin-top: 20px; text-align: center;">
    <% if @status == "playing" %>
      <button type="submit" style="padding: 10px 30px; background: #27ae60; color: white; border: none; border-radius: 5px; font-size: 1.1rem; cursor: pointer;">
        ✅ Проверить всё поле
      </button>
    <% end %>
  </div>
<% end %>

<div style="margin-top: 30px; text-align: center;">
  <%= button_to '🔄 Сбросить игру', sudoku_path, method: :delete,
      style: "padding: 8px 20px; background: #e74c3c; color: white; border: none; border-radius: 5px; cursor: pointer;" %>

  <%= link_to '🏠 В меню', minigames_menu_path,
      style: "margin-left: 15px; padding: 8px 20px; background: #3498db; color: white; text-decoration: none; border-radius: 5px;" %>
</div>

<p style="font-size: 0.9rem; color: #666; margin-top: 20px; max-width: 400px; margin-left: auto; margin-right: auto;">
  💡 Вводи цифры 1-9 в пустые клетки. Каждая строка, столбец и блок 3×3 должны содержать все цифры без повторений.
</p>