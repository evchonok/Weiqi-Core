<style>
  .tasks-container { max-width: 1200px; margin: 0 auto; padding: 40px 20px; font-family: 'Georgia', serif; }
  .tasks-header { text-align: center; margin-bottom: 50px; }
  .tasks-title { font-size: 2.5rem; color: #2d3748; margin-bottom: 10px; display: flex; align-items: center; justify-content: center; gap: 15px; }
  .tasks-subtitle { color: #718096; font-size: 1.1rem; font-family: 'Courier New', monospace; }
  
  .modes-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 25px; margin-bottom: 40px; }
  .mode-card { background: white; border-radius: 16px; padding: 40px 30px; text-align: center; box-shadow: 0 4px 15px rgba(0,0,0,0.08); transition: transform 0.3s, box-shadow 0.3s; border: 2px solid transparent; }
  .mode-card:hover { transform: translateY(-5px); box-shadow: 0 8px 25px rgba(102,126,234,0.15); }
  .mode-card.normal { border-color: #667eea; }
  .mode-card.horror { border-color: #9f7aea; }
  .mode-icon { font-size: 4rem; margin-bottom: 20px; }
  .mode-card h3 { font-size: 1.8rem; color: #2d3748; margin-bottom: 15px; }
  .mode-card p { color: #718096; margin-bottom: 25px; line-height: 1.6; }
  
  .btn-mode { display: inline-block; padding: 14px 40px; border-radius: 10px; text-decoration: none; font-weight: 600; font-size: 1.1rem; transition: all 0.3s; border: none; cursor: pointer; }
  .btn-normal { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; }
  .btn-normal:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(102,126,234,0.4); }
  .btn-horror { background: linear-gradient(135deg, #9f7aea 0%, #667eea 100%); color: white; }
  .btn-horror:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(159,122,234,0.4); }
  
  .levels-section { display: none; }
  .levels-section.active { display: block; }
  .levels-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 25px; margin-bottom: 30px; }
  .level-card { background: white; border-radius: 16px; padding: 35px 30px; box-shadow: 0 4px 15px rgba(0,0,0,0.08); transition: all 0.3s; border: 2px solid #e2e8f0; }
  .level-card:hover { transform: translateY(-5px); box-shadow: 0 8px 25px rgba(102,126,234,0.15); border-color: #667eea; }
  .level-card h3 { font-size: 1.6rem; color: #2d3748; margin-bottom: 10px; }
  .level-card p { color: #718096; margin-bottom: 20px; line-height: 1.5; }
  .level-difficulty { display: inline-block; padding: 5px 12px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border-radius: 6px; font-size: 0.85rem; font-weight: 600; margin-bottom: 15px; }
  .btn-level { display: inline-block; padding: 12px 30px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; text-decoration: none; border-radius: 10px; font-weight: 600; transition: all 0.3s; }
  .btn-level:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(102,126,234,0.4); }
  .btn-back { display: inline-block; padding: 12px 30px; background: #718096; color: white; text-decoration: none; border-radius: 10px; font-weight: 600; transition: all 0.3s; margin-top: 20px; }
  .btn-back:hover { background: #4a5568; transform: translateY(-2px); }
  
  @media (max-width: 768px) { .tasks-title { font-size: 2rem; } .modes-grid, .levels-grid { grid-template-columns: 1fr; } }
</style>

<div class="tasks-container">
  <div class="tasks-header">
    <h1 class="tasks-title">🎯 Задачник</h1>
    <p class="tasks-subtitle">Решайте задачи по вейци и совершенствуйте навыки</p>
  </div>

  <% if params[:horror].nil? %>
    <div class="modes-grid">
      <div class="mode-card normal">
        <div class="mode-icon">🧩</div>
        <h3>Обычный режим</h3>
        <p>Спокойное решение задач без сюрпризов.</p>
        <%= link_to "Играть", tasks_menu_path(horror: false), class: "btn-mode btn-normal" %>
      </div>

      <div class="mode-card horror">
        <div class="mode-icon">👻</div>
        <h3>Хоррор-режим</h3>
        <p>Ошибки будут наказаны...</p>
        <%= link_to "Играть", tasks_menu_path(horror: true), class: "btn-mode btn-horror" %>
      </div>
    </div>

  <% else %>
    <div class="levels-section active">
      <div class="tasks-header" style="margin-bottom: 30px;">
        <h2 style="color: #2d3748; font-size: 1.8rem;">
          <%= params[:horror] == "true" ? "👻 Хоррор" : "🧩 Обычный" %> режим
        </h2>
        <p style="color: #718096; margin-top: 10px;">Выберите уровень сложности</p>
      </div>

      <div class="levels-grid">
        <% @levels.each do |level| %>
          <div class="level-card">
            <span class="level-difficulty">Уровень <%= level.difficulty %></span>
            <h3><%= level.name %></h3>
            <p><%= level.description %></p>
            <%= link_to "Выбрать", task_level_task_types_path(level, horror: params[:horror]), class: "btn-level" %>
          </div>
        <% end %>
      </div>

      <div style="text-align: center;">
        <%= link_to "← Сменить режим", tasks_menu_path, class: "btn-back" %>
      </div>
    </div>
  <% end %>

  <div style="text-align: center; margin-top: 30px;">
    <%= link_to "← В главное меню", dashboard_path, class: "btn-back" %>
  </div>
</div>