<%# app/views/tasks/menu.html.erb %>
<div class="task-page">
  <% if params[:horror].nil? %>
    <!-- === ЭКРАН ВЫБОРА РЕЖИМА === -->
    <h1>🧩 Задачник</h1>
    <p class="subtitle">Выбери режим игры</p>

    <div class="modes-grid">
      <!-- Обычный режим -->
      <div class="mode-card normal">
        <div class="mode-icon">️</div>
        <h3>Обычный режим</h3>
        <p>Спокойное решение задач без сюрпризов.</p>
        <%= link_to "Играть", tasks_menu_path(horror: false), class: "btn btn-normal" %>
      </div>

      <!-- Хоррор режим -->
      <div class="mode-card horror">
        <div class="mode-icon"></div>
        <h3>Хоррор режим</h3>
        <p>Ошибки будут наказаны...</p>
        <%= link_to "Играть", tasks_menu_path(horror: true), class: "btn btn-horror" %>
      </div>
    </div>

  <% else %>
    <!-- === ЭКРАН ВЫБОРА УРОВНЯ (Старый код) === -->
    <div class="level-header">
      <h1>🧩 Задачник: <%= @horror_mode ? "Хоррор" : "Обычный" %> режим</h1>
      <%= link_to "Сменить режим", tasks_menu_path, class: "btn-small" %>
    </div>

    <div class="levels-grid">
      <% @levels.each do |level| %>
        <div class="level-card">
          <h3><%= level.name %></h3>
          <p><%= level.description %></p>
          <!-- ВАЖНО: передаем horror: params[:horror] дальше по цепочке! -->
          <%= link_to "Выбрать задачи", task_level_task_types_path(level, horror: params[:horror]), class: "btn" %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= link_to "← В главное меню", dashboard_path, class: "btn-back" %>
</div>

<style>
  .task-page { max-width: 900px; margin: 0 auto; padding: 20px; text-align: center; color: #333; }
  .subtitle { color: #666; margin-bottom: 30px; }
  
  /* Стили для карточек режимов */
  .modes-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; margin-bottom: 40px; }
  .mode-card { padding: 30px; border-radius: 16px; transition: transform 0.3s; }
  .mode-card:hover { transform: translateY(-5px); }
  .mode-icon { font-size: 4rem; margin-bottom: 15px; }
  
  /* Обычный режим */
  .mode-card.normal { background: #f0f9ff; border: 2px solid #38bdf8; }
  .mode-card.normal h3 { color: #0369a1; }
  .btn-normal { background: #38bdf8; color: white; padding: 10px 25px; border-radius: 8px; text-decoration: none; font-weight: bold; }
  
  /* Хоррор режим */
  .mode-card.horror { background: #1a0505; border: 2px solid #ef4444; color: #fff; }
  .mode-card.horror h3 { color: #ef4444; }
  .btn-horror { background: #ef4444; color: white; padding: 10px 25px; border-radius: 8px; text-decoration: none; font-weight: bold; }
  
  /* Стили уровней */
  .levels-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; }
  .level-card { background: #f8f9fa; padding: 20px; border-radius: 12px; border: 1px solid #ddd; }
  .btn { display: inline-block; margin-top: 10px; padding: 8px 20px; background: #667eea; color: white; text-decoration: none; border-radius: 6px; }
  .btn-back { display: block; margin-top: 30px; color: #666; text-decoration: none; }
  .btn-small { color: #666; text-decoration: underline; font-size: 0.9rem; }
</style>